# Secrets -- never commit these
backend/.env
frontend/.env.local
frontend/.env

# Google Cloud service-account keys. A leaked key lets anyone bill your
# project, so these must never be committed -- keep them outside the repo if
# you can, and these patterns catch them if you do not.
*.json.key
gcp-*.json
*service-account*.json
*-credentials.json
backend/keys/

# Audio produced by test-tts.js
backend/tts-test-*.mp3

# Caregiver-uploaded pictures and audio.
#
# These are a family's own photographs and recordings of their child's world.
# They are user DATA, not source: they belong in the deployment's storage, not
# in the repository, and committing them would publish private material.
backend/uploads/

# Dependencies
backend/node_modules/
frontend/node_modules/

# Build output
frontend/dist/

.claude/